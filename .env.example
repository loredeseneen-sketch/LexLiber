# --- LLM provider -----------------------------------------------------
# "claude" (default, richiede ANTHROPIC_API_KEY) oppure "ollama"
# (100% locale, nessuna chiamata esterna, richiede Ollama installato).
LLM_PROVIDER=claude

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# Usato solo se LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Vector store (Qdrant, locale via docker-compose) ------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=lexliber_corpus

# --- Embeddings (locali, sentence-transformers) -------------------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIM=768

# --- Regola citation (CRITICA, vedi CLAUDE.md) --------------------------
CITATION_MIN_SCORE=0.75
CITATION_MAX_EXCERPT_LINES=3
CITATION_TOP_K=5

# --- API server ----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Storico conversazioni (SQLite locale) -------------------------------
SQLITE_PATH=./data/lexliber.db

# --- Reranking locale (cross-encoder, vedi search/reranker.py) ----------
# Affina il ranking del bi-encoder; se il modello non è disponibile si
# ricade silenziosamente sull'ordinamento per similarità coseno.
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_CANDIDATE_MULTIPLIER=5
RERANK_MIN_CANDIDATES=20
